# SignalFlow — Environment Variables
# Copy to .env and adjust

# API (optional)
# API_HOST=0.0.0.0
# API_PORT=8000

# Data (optional — Yahoo Finance works without key)
# ALPHA_VANTAGE_KEY=

# External Features — FRED (free: https://fred.stlouisfed.org/docs/api/api_key.html)
# FRED_API_KEY=your_32_char_key_here

# ML — Stat-Led with ML Safeguard (Negative Filter) [Success config: lock 0.80]
# Block only when P(down) > threshold. Sweet spot from stability: 0.80.
ML_NEGATIVE_FILTER_THRESHOLD=0.80

# Legacy (deprecated)
# ML_DISASTER_THRESHOLD=0.80
# ML_THRESHOLD=0.6

# Paths
# STORAGE_PATH=./storage
# Model: storage/lstm_model.pt (prod), storage/lstm_model_backup.pt (pre-retrain backup)
# DATA_CACHE_DAYS=7
