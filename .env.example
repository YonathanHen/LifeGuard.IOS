# SignalFlow — Environment Variables
# Copy to .env and adjust

# API (optional)
# API_HOST=0.0.0.0
# API_PORT=8000

# Data (optional — Yahoo Finance works without key)
# ALPHA_VANTAGE_KEY=

# External Features — FRED (free: https://fred.stlouisfed.org/docs/api/api_key.html)
# FRED_API_KEY=your_32_char_key_here

# Paths
# STORAGE_PATH=./storage
# DATA_CACHE_DAYS=7
